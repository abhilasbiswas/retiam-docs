    {
      "id": "calculus-annotations",
      "blocks": [
        {
          "type": "heading",
          "level": 2,
          "text": "Calculus annotations"
        },
        {
          "type": "tabs",
          "tabs": [
            {
              "label": "Tangent",
              "blocks": [
