                }
              ]
            },
            {
              "label": "Riemann",
              "blocks": [
                {
                  "type": "example",
                  "example": "labs/pg-calculus-riemann"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "text": "CoordinateSystem exposes area, Riemann rectangles, tangent, secant and guide-line helpers. getTangentLine receives x first, then the graph/function. getRiemannRectangles receives the graph/function, x range, dx and options as separate arguments. Sampling, rule choice and finite-difference epsilon determine numerical accuracy."
        },
        {
          "type": "code",
          "language": "typescript",
          "code": "const graph = axes.plot((x) => x * x, { primitive: \"path\" });\nconst tangent = axes.getTangentLine(1, graph, { length: 3 });\nconst rectangles = axes.getRiemannRectangles(graph, [0, 2], 0.25, { fill: hex(\"#38BDF8\", 0.3333) });\nthis.add(axes, graph, tangent, rectangles);"
        },
        {
          "type": "paragraph",
          "text": "Exact contracts: [AreaUnderCurveOptions](/api-entities-composites-plotting#calculus), [RiemannRectanglesOptions](/api-entities-composites-plotting#calculus), [TangentLineOptions](/api-entities-composites-plotting#calculus), [SecantSlopeGroupOptions](/api-entities-composites-plotting#calculus)."
        }
      ]
    },
    {
