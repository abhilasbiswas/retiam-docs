    {
      "id": "make-a-demo-reproducible",
      "blocks": [
        {
          "type": "heading",
          "level": 2,
          "text": "Make a demo reproducible"
        },
        {
          "type": "list",
          "ordered": true,
          "items": [
            "Use the same checkout and rendering configuration as the demo.",
            "Resolve assets and load fonts or backend runtimes before capture.",
            "Replace repository-relative imports only when moving to a consuming app.",
            "Type-check the scene and inspect intermediate frames; static lint is not sufficient.",
            "Record any input replay and fix time steps/seeds when the subject is interactive."
          ]
        }
      ]
    }
