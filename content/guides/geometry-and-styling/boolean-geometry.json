  "id": "boolean-geometry",
  "title": "Boolean geometry and annotations",
  "group": "Geometry and styling",
  "summary": "Combine outlines with geometric operations and attach annotations to the result.",
  "sections": [
    {
      "id": "combine-vector-shapes",
      "blocks": [
        {
          "type": "heading",
          "level": 2,
          "text": "Combine vector shapes"
