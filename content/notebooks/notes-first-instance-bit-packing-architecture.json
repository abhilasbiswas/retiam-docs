    {
      "id": "8-quick-cheat-sheet-for-engine-developers",
      "blocks": [
        {
          "type": "heading",
          "level": 2,
          "text": "8. Quick Cheat Sheet for Engine Developers"
        },
        {
          "type": "heading",
          "level": 4,
          "text": "Encoding:"
        },
        {
          "type": "code",
          "language": "typescript",
          "code": "// 1. Single Entity Draw Call\nconst firstInstance = packInstanceIndex(stateIndex, 0, false, false);\n\n// 2. Stroke Draw Call\nconst strokeInstance = packInstanceIndex(stateIndex, 0, false, true);\n\n// 3. Hardware Instanced Batch (Span-Checked)\nconst isMega = (localStart + instanceCount) > 16384;\nconst firstInstance = packInstanceIndex(stateIndex, localStart, isMega, isStroke);"
        },
        {
          "type": "heading",
          "level": 4,
          "text": "WGSL Decoding:"
        },
        {
          "type": "code",
          "language": "wgsl",
