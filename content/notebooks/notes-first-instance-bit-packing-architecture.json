            "Bit 31",
            "Bit 30",
            "State index bits",
            "Local instance bits"
          ],
          "rows": [
            {
              "cells": [
                "Standard",
                "`0`",
                "`S`",
                "29–14: 16 bits, values 0–65,535",
                "13–0: 14 bits, values 0–16,383"
              ]
            },
            {
              "cells": [
                "Mega-instance",
                "`1`",
                "`S`",
                "29–18: 12 bits, values 0–4,095",
                "17–0: 18 bits, values 0–262,143"
              ]
            }
          ]
        },
        {
          "type": "heading",
