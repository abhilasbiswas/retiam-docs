            "Field",
            "Mode 0 (Standard)",
            "Mode 1 (Mega)",
            "Description"
          ],
          "rows": [
            {
              "cells": [
                {
                  "text": "**Bit 31**",
                  "type": "text"
                },
                {
                  "text": "`is_mega`"
                },
                {
